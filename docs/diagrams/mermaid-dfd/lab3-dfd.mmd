flowchart TB
    User["Внешняя сущность E1<br/>Пользователь"]:::entity
    P1(["1.0 Приём и авторизация запроса<br/>API Gateway"]):::process
    P2(["2.0 Получение группы,<br/>специальности и department_id"]):::process
    P3(["3.0 Выборка студентов группы<br/>и лекционных занятий за период"]):::process
    P4(["4.0 Отбор курсов кафедры<br/>и расчёт плановых и посещённых часов"]):::process
    P5(["5.0 Получение профилей студентов<br/>из кэша или PostgreSQL"]):::process
    P6(["6.0 Получение кафедры,<br/>института и университета группы"]):::process
    P7(["7.0 Формирование<br/>JSON-отчёта"]):::process
    D1a[("D1.1 PostgreSQL<br/>Группы и специальности")]:::store
    D1b[("D1.2 PostgreSQL<br/>Курсы и посещения")]:::store
    D1c[("D1.3 PostgreSQL<br/>Профили студентов")]:::store
    D2[("D2 Neo4j<br/>Студент → группа → расписание<br/>→ лекция → курс")]:::store
    D3[("D3 MongoDB<br/>university_hierarchy")]:::store
    D4[("D4 Redis<br/>JSON-профили студентов<br/>Ключ — student_id; TTL — сутки")]:::store
    User -->|"JWT; group_id;<br/>period_start; period_end"| P1
    P1 -->|"UUID группы и период отчёта"| P2
    P2 -->|"group_id"| D1a
    D1a -->|"Группа, специальность,<br/>department_id"| P2
    P2 -->|"group_id, department_id;<br/>период и сведения группы"| P3
    P3 -->|"group_id; даты включительно;<br/>type = Lecture"| D2
    D2 -->|"Уникальные student_id;<br/>schedule_id по course_id"| P3
    P3 -->|"Состав группы, занятия по курсам;<br/>кафедра, период и сведения группы"| P4
    P4 -->|"course_id; department_id группы"| D1b
    D1b -->|"Только курсы кафедры группы;<br/>названия, описание и часы курса"| P4
    P4 -->|"Пары schedule_id — course_id;<br/>student_id; период; mark = 1"| D1b
    D1b -->|"Уникальные посещения<br/>по студенту и курсу"| P4
    P4 -->|"Все студенты группы; курсы;<br/>план и факт: число занятий × 2 часа;<br/>сведения группы и период"| P5
    P5 -->|"student_id всех студентов группы"| D4
    D4 -->|"JSON-профили<br/>или отсутствующие / невалидные данные"| P5
    P5 -->|"Отсутствующие student_id и group_id<br/>при промахе или недоступности Redis"| D1c
    D1c -->|"Полные профили;<br/>подтверждённый состав группы"| P5
    P5 -->|"Профили из PostgreSQL;<br/>ключ student_id; TTL 86400 с"| D4
    P5 -->|"Группа, студенты и часы по курсам;<br/>department_id; период"| P6
    P6 -->|"department_id группы"| D3
    D3 -->|"Кафедра, институт и университет"| P6
    P6 -->|"Полные сведения о группе и студентах;<br/>курсы, плановые и посещённые часы"| P7
    P7 -->|"JSON-отчёт по группе<br/>с планом и фактом по студентам и курсам"| P1
    P1 -->|"HTTP-ответ с отчётом"| User
